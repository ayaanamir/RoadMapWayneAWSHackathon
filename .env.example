# Copy to .env and fill in. Never commit .env. Same names go in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=            # Neon → project still-there-builderwars → Connect
BLOB_READ_WRITE_TOKEN=   # Vercel → Storage → Blob store (auto-set on Vercel; needed locally only)
API_BASE_URL=            # the Vercel deployment URL, e.g. https://still-there.vercel.app
OPENROUTER_API_KEY=
OPENROUTER_MODEL=        # any vision-capable model id on OpenRouter

# Improve Detroit (public, no key)
CITY_FEATURESERVER=https://services2.arcgis.com/qvkbeam7Wirps6zC/arcgis/rest/services/improve_detroit/FeatureServer/0
