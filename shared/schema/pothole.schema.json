{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pothole.schema.json",
  "title": "Pothole",
  "type": "object",
  "required": [
    "pothole_id",
    "lat",
    "lon",
    "address",
    "city_reports",
    "detections",
    "state"
  ],
  "properties": {
    "pothole_id": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "city_reports": {
      "type": "array",
      "items": {
        "$ref": "city_report.schema.json"
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "$ref": "detection.schema.json"
      }
    },
    "state": {
      "enum": [
        "still_there",
        "fixed_confirmed",
        "reported_only",
        "unreported",
        "unknown"
      ]
    },
    "last_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "owner": {
      "type": "object",
      "description": "Who fixes this road and where to report it. Added in contract v5.",
      "required": ["key", "agency", "short", "via", "route", "reason"],
      "properties": {
        "key": { "enum": ["city", "state"] },
        "agency": { "type": "string" },
        "short": { "type": "string" },
        "via": { "type": "string" },
        "route": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      }
    }
  }
}